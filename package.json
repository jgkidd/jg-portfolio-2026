{
  "name": "jgkidd-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --import tsx scripts/generate.ts && vite --host 127.0.0.1",
    "build": "node --import tsx scripts/generate.ts && tsc --noEmit && vite build && node --import tsx scripts/verify.ts",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test scripts/site.test.ts"
  },
  "devDependencies": {
    "vite": "^8.3.4",
    "typescript": "^7.0.2",
    "@types/node": "^24.19.2",
    "cheerio": "^1.2.0",
    "tsx": "^4.23.15"
  }
}
